{
  "info": {
    "name": "PrestaControl",
    "_postman_id": "b8f6d7f2-9f6e-4d47-a5f1-2c4b8f6a1234",
    "description": "Colección Postman para PrestaControl API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "jwt_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Guarda jwt_token', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('jwt_token', json.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Perez\",\n  \"email\": \"juan.perez@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Guarda jwt_token', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('jwt_token', json.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan.perez@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Prestamos",
      "item": [
        {
          "name": "Crear Préstamo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{jwt_token}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"Maria Lopez\",\n  \"dni\": \"12345678\",\n  \"monto\": 1000.00,\n  \"interes\": 10.00,\n  \"fechaVencimiento\": \"2026-12-31\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/prestamos",
              "host": ["{{base_url}}"],
              "path": ["prestamos"]
            }
          }
        },
        {
          "name": "Listar Préstamos",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{jwt_token}}", "type": "string" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/prestamos",
              "host": ["{{base_url}}"],
              "path": ["prestamos"]
            }
          }
        },
        {
          "name": "Obtener Préstamo por ID",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{jwt_token}}", "type": "string" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/prestamos/1",
              "host": ["{{base_url}}"],
              "path": ["prestamos", "1"]
            }
          }
        },
        {
          "name": "Actualizar Préstamo",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{jwt_token}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"Maria Lopez\",\n  \"dni\": \"12345678\",\n  \"monto\": 1200.00,\n  \"interes\": 12.00,\n  \"fechaVencimiento\": \"2027-01-31\",\n  \"pagado\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/prestamos/1",
              "host": ["{{base_url}}"],
              "path": ["prestamos", "1"]
            }
          }
        },
        {
          "name": "Eliminar Préstamo",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{jwt_token}}", "type": "string" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/prestamos/1",
              "host": ["{{base_url}}"],
              "path": ["prestamos", "1"]
            }
          }
        },
        {
          "name": "Resumen de Cartera",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{jwt_token}}", "type": "string" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/prestamos/resumen",
              "host": ["{{base_url}}"],
              "path": ["prestamos", "resumen"]
            }
          }
        },
        {
          "name": "Listar Préstamos (Sin Token - Test 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/prestamos",
              "host": ["{{base_url}}"],
              "path": ["prestamos"]
            }
          }
        }
      ]
    }
  ]
}
